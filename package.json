{
  "name": "unimart-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UniMart – Smart Student Marketplace for Rajarata University of Sri Lanka",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm run build --workspace=client",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  },
  "keywords": [
    "unimart",
    "campus-marketplace",
    "rajarata-university"
  ],
  "author": "Group 05 (Sudo Six) - Faculty of Technology, RUSL",
  "license": "MIT"
}
