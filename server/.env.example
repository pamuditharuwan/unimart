# UniMart Express API Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=unimart_super_secret_jwt_key_ict_1108_project

# University Domain Restriction (comma separated allowed email domains or patterns)
# Example: @student.rjt.ac.lk,.ac.lk
ALLOWED_DOMAINS=@student.rjt.ac.lk,.ac.lk

# Supabase Credentials (Optional for local memory mode; required for persistent cloud DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client URL for CORS
CLIENT_URL=http://localhost:5173
